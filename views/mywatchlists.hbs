<style>
:root{
  --clr-bg:#f5f7fa;
  --clr-card:#ffffff;
  --clr-primary:#32c2ff;
  --clr-primary-d:#1ea0d6;
  --clr-border:#e2e6ee;
  --radius:14px;
  --shadow-sm:0 2px 6px rgba(0,0,0,.06);
  --shadow-md:0 4px 14px rgba(0,0,0,.08);
  --transition:.2s cubic-bezier(.4,0,.2,1);
}

.container{
  max-width:1100px; 
  margin:0 auto;
  padding:0 24px;
}

body {
  background:var(--clr-bg);
  margin: 0;
  font-family: 'Poppins', sans-serif;
} /* fallback if page rendered standalone */

/* Navigation styles */
nav.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(90deg, #0f172a, #1e293b);
  padding: 14px 32px;
  color: white;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.logo {
  font-size: 26px;
  font-weight: 600;
  color: #3bc9f3;
  display: flex;
  align-items: center;
  gap: 8px;
}

.navbar-center a {
  margin: 0 16px;
  text-decoration: none;
  color: #d1d5db;
  font-weight: 500;
  font-size: 16px;
  transition: all 0.2s ease-in-out;
}

.navbar-center a:hover {
  color: #ffffff;
  text-decoration: underline;
}

.navbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.back-btn {
  background-color: #3bc9f3;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: background-color 0.2s;
  text-decoration: none;
  display: inline-block;
}

.back-btn:hover {
  background-color: #0ea5e9;
  color: white;
  text-decoration: none;
}

.create-btn {
  background-color: #10b981;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: background-color 0.2s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.create-btn:hover {
  background-color: #059669;
  color: white;
  text-decoration: none;
}

.page-wrapper{
  max-width: 1100px;        
  margin: 40px auto;           
  padding: 0 24px;
}

.tab-strip{
  display: flex; 
  justify-content: center; 
  margin-bottom: 2rem 0 3.5rem;
}

.tab-item{
  border: 1px solid #d1d5db;
  background: #f3f4f6;
  color: #6b7280;
  padding: 0.6rem 2rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  min-width: 110px;
  text-align: center;
  font-size: 1rem;
  position: relative;
}

.tab-item:first-child {
  border-radius: var(--radius) 0 0 var(--radius);
  border-right: 1px solid #d1d5db;
}

.tab-item:last-child {
  border-radius: 0 var(--radius) var(--radius) 0;
  border-left: 1px solid #d1d5db;
} 
.tab-item:hover{
  background: #f1f5f9;
  color: #475569;
}
.tab-item.tab-active{
  background: var(--clr-card);
  color: #1d2a4d;
  border-color: #d1d5db;
  box-shadow: var(--shadow-sm);
  z-index: 1;
} 

.pane{
  display: none;
  margin-top: 2rem;
}
.pane.active{
  display: grid;
  grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
  gap: 1.8rem;
  margin-top: 2rem;
}

.watch-card{background:var(--clr-card);border-radius:var(--radius);padding:1rem;box-shadow:var(--shadow-sm);transition:var(--transition);} 
.watch-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);} 
.watch-card h3{margin:.2rem 0 .8rem;font-size:1.1rem;font-weight:700;}
.poster-row{display:flex;gap:.5rem;}
.poster-row img{border-radius:8px;width:72px;height:104px;object-fit:cover;}
</style>

<!-- Navigation Bar -->
<nav class="navbar">
    <div class="logo">🎬 Movie Lovers</div>
    <div class="navbar-center">
        <a href="/">Home</a>
        <a href="/my-watchlists">My Watchlists</a>
        <a href="/explore">Explore</a>
    </div>
    <div class="navbar-right">
        <button id="createBtn" class="create-btn">
            <span style="font-weight:bold;font-size:1.2rem;line-height:1">＋</span> Create New
        </button>
        <a href="/" class="back-btn">← Back to Home</a>
    </div>
</nav>

<div class="page-wrapper">
    <nav class="tab-strip" role="tablist">
      <button class="tab-item tab-active" data-target="pane-created" aria-selected="true">Created</button>
      <button class="tab-item" data-target="pane-saved" aria-selected="false">Saved</button>
    </nav>

  <div id="pane-created" class="pane active">
    {{#each createdLists}}
      <a href="/watchlist/{{this._id}}" class="watch-card">
        <h3>{{this.name}}</h3>
        <div class="poster-row">
          {{#each this.movies}}
            <img src="{{this.poster}}" alt="{{this.title}} poster">
          {{/each}}
        </div>
      </a>
    {{/each}}
  </div>

  <div id="pane-saved" class="pane">
    {{#each savedLists}}
      <a href="/watchlist/{{this._id}}" class="watch-card">
        <h3>{{this.name}}</h3>
        <div class="poster-row">
          {{#each this.movies}}
            <img src="{{this.poster}}" alt="{{this.title}} poster">
          {{/each}}
        </div>
      </a>
    {{/each}}
  </div>
  </div>

<script>
(function(){
  const tabs = document.querySelectorAll('.tab-item');
  const panes = document.querySelectorAll('.pane');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {t.classList.remove('tab-active'); 
      t.setAttribute('aria-selected','false');
      });
      tab.classList.add('tab-active');
      tab.setAttribute('aria-selected','true');
      panes.forEach(p => p.classList.remove('active'));
      document.getElementById(tab.dataset.target).classList.add('active');
    });
  });

  // Create New Watchlist functionality
  const createBtn = document.getElementById('createBtn');
  createBtn.addEventListener('click', async () => {
    const listName = prompt('Enter a name for your new watchlist:');
    if (listName && listName.trim()) {
      try {
        const response = await fetch('/createNewList', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ listName: listName.trim() })
        });

        if (response.ok) {
          const result = await response.json();
          if (result.success) {
            alert('Watchlist created successfully! Redirecting to add movies...');
            // Redirect to the newly created watchlist page
            window.location.href = `/watchlist/${result.watchlistId}`;
          } else {
            alert('Error creating watchlist: ' + (result.message || 'Unknown error'));
          }
        } else {
          alert('Error creating watchlist. Please try again.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error creating watchlist. Please try again.');
      }
    }
  });
})();
</script>
