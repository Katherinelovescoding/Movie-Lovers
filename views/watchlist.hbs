<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{listName}} - Movie Watchlist</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #f4f4f4;
      padding: 2rem;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header h2 {
      margin: 0;
      font-size: 2rem;
    }

    .movie-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
    }

    .movie-card {
      background: white;
      border: 1px solid #ccc;
      border-radius: 10px;
      padding: 0.5rem;
      width: 160px;
      text-align: center;
    }

    .movie-card img {
      width: 100%;
      height: 240px;
      object-fit: cover;
      border-radius: 5px;
    }

    .movie-title {
      margin-top: 0.5rem;
      font-size: 1rem;
      font-weight: bold;
    }

    .back-btn {
      padding: 8px 12px;
      background-color: #555;
      color: white;
      text-decoration: none;
      border-radius: 5px;
    }

    .delete-btn {
      margin-top: 6px;
      font-size: 0.8rem;
      background-color: #e74c3c;
      color: white;
      border: none;
      border-radius: 4px;
      padding: 4px 8px;
      cursor: pointer;
    }
  </style>
</head>
<body>

<div class="header">
  <div style="margin: 1rem 0;">
    {{#if isSaved}}
    <form method="POST" action="/unsaveWatchlist">
      <input type="hidden" name="watchlistId" value="{{watchlistId}}">
      <button type="submit" class="delete-btn">❌ Unsave</button>
    </form>
    {{else}}
    <form method="POST" action="/saveWatchlist">
      <input type="hidden" name="watchlistId" value="{{watchlistId}}">
      <button type="submit">❤️ Save</button>
      </form>
    {{/if}}
  </div>

  <h2>{{listName}}</h2>
  <a href="/mywatchlists" class="back-btn">← Back to My Watchlists</a>
</div>

<div class="movie-grid">
  {{#each movies}}
    <div class="movie-card">
      <img src="{{this.poster}}" alt="{{this.title}}">
      <div class="movie-title">{{this.title}}</div>
      {{#if ../showDelete}}
        <form method="POST" action="/watchlist/{{../watchlistId}}/removeMovie">
          <input type="hidden" name="movieId" value="{{this._id}}">
          <button type="submit" class="delete-btn">Remove</button>
        </form>
      {{/if}}
    </div>
  {{/each}}
</div>

</body>
</html>
