{{!-- views/explore.hbs --}}
{{> header}}

<h2>Explore Public Watchlists</h2>

<form method="GET" action="/explore" style="text-align: center; margin-bottom: 1.5rem;">
  <label for="sort">Sort by:</label>
  <select name="sort" id="sort" onchange="this.form.submit()">
    <option value="newest" {{#if (eq currentSort 'newest')}}selected{{/if}}>Newest</option>
    <option value="oldest" {{#if (eq currentSort 'oldest')}}selected{{/if}}>Oldest</option>
    <option value="mostSaved" {{#if (eq currentSort 'mostSaved')}}selected{{/if}}>Most Saved</option>
  </select>
</form>

<div class="watchlist-grid">
  {{#each publicLists}}
    <div class="watchlist-card">
      <h3>{{this.name}}</h3>
      <p><strong>Created by:</strong> {{this.owner.username}}</p>

      <div class="poster-preview">
        {{#each this.movies}}
          {{#if @index}}
            {{#if @first}}<div class="movie-posters">{{/if}}
            <img src="{{this.poster}}" alt="{{this.title}}" class="poster-thumb">
            {{#if @last}}</div>{{/if}}
          {{/if}}
        {{/each}}
      </div>

      <form action="/saveWatchlist" method="POST">
        <input type="hidden" name="watchlistId" value="{{this._id}}">
        <button type="submit">❤️ Save</button>
      </form>
    </div>
  {{/each}}
</div>

{{> footer}}
