<!DOCTYPE html>
<html>
<head>
    <title>Movie Lovers</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f9fafb;
        }

        nav.navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(90deg, #111827, #1f2937);
            padding: 12px 24px;
            color: white;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #38bdf8;
        }

        .navbar-center a {
            margin: 0 12px;
            text-decoration: none;
            color: #e0e0e0;
            font-weight: 500;
            transition: color 0.2s;
        }

        .navbar-center a:hover {
            color: #ffffff;
            text-decoration: underline;
        }

        .navbar-right form {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-right: 12px;
        }

        .navbar-right input {
            padding: 6px 10px;
            border-radius: 4px;
            border: none;
        }

        .navbar-right button {
            background-color: #38bdf8;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
        }

        .user-badge {
            margin-left: 12px;
            font-size: 14px;
            color: #d1d5db;
        }

        .movie-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            padding: 20px;
        }

        .movie-grid img {
            margin: 10px;
            height: 280px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
            transition: transform 0.2s;
        }

        .movie-grid img:hover {
            transform: scale(1.05);
        }

        h2 {
            text-align: center;
            color: #333;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="logo">🎬 Movie Lovers</div>
        <div class="navbar-center">
            <a href="/index.html">Home</a>
            <a href="/my-watchlists">My Watchlists</a>
            <a href="/explore">Explore</a>
            {{#if isAdmin}}<a href="/users">Admin</a>{{/if}}
        </div>
        <div class="navbar-right">
            <form action="/search" method="GET">
                <input type="text" name="q" placeholder="Search by title or IMDB ID" />
                <button type="submit">Search</button>
            </form>
            <span class="user-badge">👋 Welcome, {{username}}</span>
        </div>
    </nav>

    <h2>Begin your day by watching a good movie...</h2>
    <div class="movie-grid">
        {{#each movies}}
            <img src="{{this.poster}}" alt="{{this.title}}">
        {{/each}}
    </div>
</body>
</html>
