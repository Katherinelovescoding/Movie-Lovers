<!DOCTYPE html>
<html>
<head>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <title>Movie Lovers</title>
    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: #f9fafb;
        }

        nav.navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(90deg, #0f172a, #1e293b);
            padding: 14px 32px;
            color: white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .logo {
            font-size: 26px;
            font-weight: 600;
            color: #3bc9f3;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .navbar-center a {
            margin: 0 16px;
            text-decoration: none;
            color: #d1d5db;
            font-weight: 500;
            font-size: 16px;
            transition: all 0.2s ease-in-out;
        }

        .navbar-center a:hover {
            color: #ffffff;
            text-decoration: underline;
        }

        .navbar-right form {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-right: 14px;
        }

        .navbar-right input {
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            outline: none;
            font-size: 14px;
        }

        .navbar-right button {
            background-color: #3bc9f3;
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .navbar-right button:hover {
            background-color: #0ea5e9;
        }

        .user-badge {
            font-size: 14px;
            color: #cbd5e1;
            margin-left: 12px;
        }

        .movie-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            padding: 40px;
        }

        .movie-card {
            width: 200px;
            height: 300px;
            background-color: white;
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .movie-grid img {
            margin: 10px;
            height: 280px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
            transition: transform 0.2s;
        }

        .movie-card img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            padding: 10px;
        }  

        .movie-grid img:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 18px rgba(0,0,0,0.25);
        }

        h2 {
            text-align: center;
            color: #333;
            margin-top: 20px;
        }

        .section-title {
            font-family: 'Georgia', serif;
            font-size: 28px;
            color: #1f2937;
            text-align: center;
            margin-top: 40px;
            margin-bottom: 10px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="logo">🎬 Movie Lovers</div>
        <div class="navbar-center">
            <a href="/index.html">Home</a>
            <a href="/my-watchlists">My Watchlists</a>
            <a href="/explore">Explore</a>
            {{#if isAdmin}}<a href="/users">Admin</a>{{/if}}
        </div>
        <div class="navbar-right">
            <form action="/search" method="GET">
                <input type="text" name="q" placeholder="Search by title or IMDB ID" />
                <button type="submit">Search</button>
            </form>
            <span class="user-badge">👋 <span>Welcome, {{username}}</span></span>
        </div>
    </nav>

    <h2 class="section-title">Begin your day by watching a good movie...</h2>
    <div class="movie-grid">
        {{#each movies}}
            {{#if this.poster}}
                <div class="movie-card" title="{{this.title}}">
                    <img src="{{this.poster}}" alt="{{this.title}}">
                </div>
            {{/if}}
        {{/each}}
</div>
</body>
</html>
